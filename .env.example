# Copy to .env and fill in your own values. .env is gitignored — never commit real keys.

# Weights & Biases (only needed when track: true)
WANDB_ENTITY=your-entity
WANDB_PROJECT=your-project
WANDB_API_KEY=your-wandb-api-key

# Hugging Face (only needed if uploading models)
HF_TOKEN=your-hf-token

# Headless MuJoCo rendering backend (egl or osmesa)
MUJOCO_GL=egl
